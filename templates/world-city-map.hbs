<section class="night-city-app" data-night-city-app>
  <header class="night-city-top"><div><small>NCNET // CITY ATLAS</small><strong>Найт-Сити</strong></div><span data-city-clock>Городская карта</span>{{#if isGM}}<label>Связи с Архивом<select data-city-archive-owner>{{#each archiveOwners}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}<label>Персонаж <select data-city-actor><option value="">Группа / обзор</option>{{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{#if isGM}}<button type="button" data-city-open-tools="encounter">Встреча</button>{{/if}}<button type="button" data-city-open-tools="clock">Часы</button><button type="button" data-city-open-services>Город</button><button type="button" data-city-open-agent>Агент</button><button type="button" data-city-open-archive><i class="fa-solid fa-brain"></i> Архив</button></header>
  <div class="night-city-stage"><div class="night-city-map-host" data-night-city-map-host></div><aside class="night-city-tools" data-night-city-tools hidden></aside></div>
</section>